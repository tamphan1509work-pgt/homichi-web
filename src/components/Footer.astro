---
import { footerNav, legalNav, site } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
interface Props { lang?: 'vi' | 'en' }
const { lang = 'vi' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer section--dark on-dark">
  <div class="container container--wide">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo inverse />
        {lang === 'en' ? (
          <p class="footer__claim">Engineering home appliances <span class="chip"><Icon name="factory" size={14} /></span> for brands <span class="chip chip--text">ODM</span> that put quality first <span class="chip"><Icon name="shield" size={14} /></span> since 2009.</p>
        ) : (
          <p class="footer__claim">Kiến tạo thiết bị gia dụng <span class="chip"><Icon name="factory" size={14} /></span> cho các thương hiệu <span class="chip chip--text">ODM</span> đặt chất lượng lên trước <span class="chip"><Icon name="shield" size={14} /></span> từ năm 2009.</p>
        )}
        <form class="footer__news" data-newsletter novalidate>
          <label for="nl-email" class="t-caption">{lang === 'en' ? 'Industry insights for buyers — monthly.' : 'Bản tin ngành ODM/OEM dành cho bộ phận mua hàng — mỗi tháng một lần.'}</label>
          <div class="footer__news-row">
            <input id="nl-email" type="email" name="email" placeholder={lang === 'en' ? 'Sign up for our newsletter' : 'Đăng ký nhận bản tin'} required autocomplete="email" />
            <button type="submit" aria-label={lang === 'en' ? 'Subscribe' : 'Đăng ký'}><Icon name="arrow" size={14} /></button>
          </div>
          <p class="footer__news-msg" role="status" aria-live="polite"></p>
        </form>
        <p class="footer__note">{site.address}<br />{site.hotline} · {site.email}</p>
      </div>
      <div class="footer__cols">
        {footerNav.map((col) => (
          <div>
            <p class="footer__title">{col.title}</p>
            <ul>{col.items.map((it) => <li><a href={it.href}>{it.label}</a></li>)}</ul>
          </div>
        ))}
        <div>
          <p class="footer__title">{lang === 'en' ? 'Social' : 'Mạng xã hội'}</p>
          <ul>{site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer__title">{lang === 'en' ? 'Legal' : 'Pháp lý'}</p>
          <ul>
            {legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li><button type="button" data-cookie-open>{lang === 'en' ? 'Consent preferences' : 'Tuỳ chọn cookie'}</button></li>
          </ul>
        </div>
        <div>
          <p class="footer__title">{lang === 'en' ? 'Contact' : 'Liên hệ'}</p>
          <ul>
            <li><a href="/lien-he/">{lang === 'en' ? 'Contact us' : 'Liên hệ'}</a></li>
            <li><a href="/bao-gia/">{lang === 'en' ? 'Request a quote' : 'Yêu cầu báo giá'}</a></li>
            <li><a href="/dat-lich-tham-quan/">{lang === 'en' ? 'Factory visit' : 'Tham quan nhà máy'}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© {year} {site.legalName} · MST 0312 345 678</p>
      <p class="footer__certs">ISO 9001 · ISO 14001 · ISO 45001 · CE · CB · RoHS · BSCI</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(56px, 6vw, 88px) 32px; margin-top: 0; }
  .footer a, .footer button { transition: opacity .2s; }
  .footer a:hover, .footer button:hover { opacity: .6; }
  .footer__top { display: grid; gap: 56px; }
  @media (min-width: 1024px) { .footer__top { grid-template-columns: 1fr 1.15fr; gap: 96px; } }
  .footer__brand { display: grid; gap: 24px; align-content: start; }
  .footer__brand :global(.logo__word) { font-size: 24px; }
  .footer__claim { font-size: clamp(20px, 1.8vw, 26px); font-weight: 350; line-height: 1.35; letter-spacing: -0.015em; max-width: 520px; }
  .chip { display: inline-grid; place-items: center; vertical-align: -0.12em; min-width: 1.5em; height: 1.1em; padding: 0 4px; border: 1px solid rgba(252,252,247,.6); border-radius: 6px; }
  .chip--text { font-family: var(--font-mono); font-size: 0.5em; letter-spacing: .04em; height: 2.1em; }
  .footer__news { display: grid; gap: 10px; max-width: 380px; }
  .footer__news label { color: rgba(252,252,247,.8); }
  .footer__news-row { display: flex; align-items: center; border: 1px solid rgba(252,252,247,.7); border-radius: var(--radius-inputs); padding: 2px 4px 2px 14px; }
  .footer__news-row input { flex: 1; min-width: 0; background: transparent; border: 0; padding: 10px 0; font-size: 13px; color: var(--color-snow-white); outline: none; }
  .footer__news-row input::placeholder { color: rgba(252,252,247,.7); }
  .footer__news-row button { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 6px; color: var(--color-snow-white); }
  .footer__news-row:focus-within { border-color: var(--color-lime-pulse); }
  .footer__news-msg { font-size: 12px; color: var(--color-lime-pulse); min-height: 16px; }
  .footer__note { font-size: 12px; line-height: 1.6; color: rgba(252,252,247,.55); max-width: 380px; padding: 12px 14px; border: 1px solid var(--line-light); border-radius: var(--radius-inputs); }
  .footer__cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 24px; }
  @media (min-width: 720px) { .footer__cols { grid-template-columns: repeat(3, 1fr); } }
  .footer__title { font-size: 10px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: rgba(252,252,247,.5); margin-bottom: 14px; }
  .footer__cols ul { display: grid; gap: 8px; font-size: 13px; }
  .footer__cols button { font-size: 13px; text-align: left; }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line-light); font-size: 12px; color: rgba(252,252,247,.55); }
  .footer__certs { font-family: var(--font-mono); letter-spacing: .04em; }
</style>
