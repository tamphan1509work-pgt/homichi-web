---
import Art, { type ArtName } from './Art.astro';

interface Props {
  art: ArtName;
  tone?: 'stone' | 'sage' | 'eucalyptus' | 'olive' | 'dark' | 'frost' | 'canvas';
  ratio?: 'default' | 'tall' | 'wide' | 'square';
  caption?: string;
  captionRight?: string;
  tag?: string;
  class?: string;
  pad?: string;
}
const { art, tone = 'stone', ratio = 'default', caption, captionRight, tag, class: cls = '', pad = '14%' } = Astro.props;
const toneClass = { stone: '', sage: 'frame--sage', eucalyptus: 'frame--eucalyptus', olive: 'frame--olive', dark: 'frame--dark', frost: 'frame--frost', canvas: 'frame--canvas' }[tone];
const ratioClass = ratio === 'default' ? '' : `frame--${ratio}`;
// Ảnh render 3D (placeholder) — thay bằng ảnh chụp thật khi có. Các khoá còn lại dùng minh hoạ line-art.
const photos: Partial<Record<ArtName, { src: string; fit: 'contain' | 'cover'; alt: string }>> = {
  fan: { src: '/images/fan.webp', fit: 'contain', alt: 'Quạt điện Homichi' },
  aircon: { src: '/images/aircon.webp', fit: 'contain', alt: 'Điều hoà không khí Homichi' },
  induction: { src: '/images/induction.webp', fit: 'contain', alt: 'Bếp từ Homichi' },
  hood: { src: '/images/hood.webp', fit: 'contain', alt: 'Máy hút mùi Homichi' },
  heater: { src: '/images/heater.webp', fit: 'contain', alt: 'Bình nước nóng Homichi' },
  factory: { src: '/images/line.webp', fit: 'cover', alt: 'Dây chuyền lắp ráp tại nhà máy Homichi' },
};
const photo = photos[art];
---
<figure class:list={['frame', toneClass, ratioClass, cls]} style={`--pad:${pad}`}>
  {tag && <span class:list={['frame__tag', tone === 'stone' || tone === 'frost' || tone === 'canvas' ? 'badge' : 'badge badge--glass']}>{tag}</span>}
  {photo ? (
    <div class:list={['frame__art', `frame__photo--${photo.fit}`]}><img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" /></div>
  ) : (
    <div class="frame__art"><Art name={art} /></div>
  )}
  {(caption || captionRight) && (
    <figcaption class="frame__caption">
      <span>{caption}</span>
      {captionRight && <span>{captionRight}</span>}
    </figcaption>
  )}
  <slot />
</figure>

<style>
  .frame__art { width: 100%; height: 100%; padding: var(--pad); display: grid; place-items: center; transition: transform 1.2s var(--ease); }
  .frame__art :global(svg) { max-height: 100%; }
  .frame__art img { width: 100%; height: 100%; object-fit: contain; }
  .frame__photo--contain { padding: calc(var(--pad) * 0.45); }
  .frame__photo--cover { padding: 0; position: absolute; inset: 0; }
  .frame__photo--cover img { object-fit: cover; }
  .frame--canvas { background: var(--color-snow-white); }
  :global(a:hover) > .frame .frame__art, :global(.card--link:hover) .frame__art { transform: scale(1.035); }
</style>
