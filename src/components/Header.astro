---
import { mainNav, site } from '../data/site';
import { categories } from '../data/products';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props { lang?: 'vi' | 'en'; altHref?: string; overlay?: boolean }
const { lang = 'vi', altHref, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const en: Record<string, string> = {
  'Về Homichi': 'About',
  'Dịch vụ ODM/OEM': 'ODM/OEM Services',
  'Năng lực': 'Capabilities',
  'Sản phẩm': 'Products',
  'Dự án & Đối tác': 'Projects & Partners',
  'Tin tức': 'News',
};
const t = (s: string) => (lang === 'en' ? en[s] ?? s : s);

// Mega menu ngành hàng được tạo từ dữ liệu sản phẩm (CMS)
const nav = mainNav.map((item) =>
  item.href === '/san-pham/'
    ? {
        ...item,
        groups: [
          { title: 'Ngành hàng', items: categories.map((c) => ({ label: c.name, href: `/san-pham/${c.slug}/`, desc: c.capacity })) },
          { title: 'Tài nguyên', items: [
            { label: 'Tất cả ngành hàng', href: '/san-pham/' },
            { label: 'Tải catalogue', href: '/san-pham/catalogue/' },
            { label: 'Ngành hàng mở rộng', href: '/san-pham/nganh-hang-mo-rong/' },
          ] },
        ],
        feature: { title: 'Catalogue 2026', text: '5 ngành hàng, 40+ mẫu sản phẩm sẵn sàng tuỳ biến thương hiệu.', href: '/san-pham/catalogue/', cta: 'Tải catalogue' },
      }
    : item,
);

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const viHref = lang === 'en' ? '/' : path;
const enHref = altHref ?? '/en/';
---
<header class:list={['header', { 'header--overlay': overlay }]} data-header>
  <div class="container container--wide header__inner">
    <a href={lang === 'en' ? '/en/' : '/'} class="header__logo" aria-label="Homichi — Trang chủ"><Logo /></a>

    <nav class="nav" aria-label={lang === 'en' ? 'Main navigation' : 'Điều hướng chính'}>
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-mega': item.groups }]}>
            <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined} aria-haspopup={item.groups ? 'true' : undefined}>
              {t(item.label)}
              {item.groups && <svg class="nav__chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 4l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>}
            </a>
            {item.groups && (
              <div class="mega">
                <div class="container container--wide mega__inner">
                  <div class="mega__intro">
                    <p class="eyebrow">{t(item.label)}</p>
                    <a href={item.href} class="link-arrow mt-16">{lang === 'en' ? 'Overview' : 'Xem tổng quan'}</a>
                  </div>
                  <div class="mega__groups">
                    {item.groups.map((g) => (
                      <div class="mega__group">
                        {g.title && <p class="t-mono t-muted mega__title">{g.title}</p>}
                        <ul>
                          {g.items.map((c) => (
                            <li>
                              <a href={c.href} class="mega__link">
                                <span>{c.label}</span>
                                {c.desc && <small>{c.desc}</small>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  {item.feature && (
                    <a href={item.feature.href} class="mega__feature">
                      <span class="badge">{lang === 'en' ? 'Resource' : 'Tài liệu'}</span>
                      <span class="t-subheading">{item.feature.title}</span>
                      <span class="t-caption mega__feature-text">{item.feature.text}</span>
                      <span class="link-arrow">{item.feature.cta}</span>
                    </a>
                  )}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href="/tim-kiem/" class="header__icon" aria-label={lang === 'en' ? 'Search' : 'Tìm kiếm'}><Icon name="search" size={16} /></a>
      <span class="lang header__lang" aria-label="Ngôn ngữ / Language">
        <a href={viHref} lang="vi" aria-current={lang === 'vi' ? 'true' : undefined}>VI</a>
        <a href={enHref} lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </span>
      <a href="/ho-so-nang-luc/" class="header__text-link header__profile">{lang === 'en' ? 'Company profile' : 'Hồ sơ năng lực'}</a>
      <a href="/bao-gia/" class="btn btn--primary btn--sm">{lang === 'en' ? 'Request a quote' : 'Yêu cầu báo giá'}</a>
      <button class="burger hide-desktop" type="button" aria-expanded="false" aria-controls="drawer" data-burger>
        <span class="visually-hidden">Menu</span>
        <span class="burger__lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-drawer hidden>
  <div class="drawer__inner">
    <ul class="drawer__list">
      <li><a href="/" class="drawer__top">{lang === 'en' ? 'Home' : 'Trang chủ'}</a></li>
      {nav.map((item) => item.groups ? (
        <li>
          <details>
            <summary class="drawer__top">{t(item.label)}</summary>
            <ul class="drawer__sub">
              <li><a href={item.href}>{lang === 'en' ? 'Overview' : 'Tổng quan'}</a></li>
              {item.groups.flatMap((g) => g.items).filter((c) => c.href !== item.href).map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          </details>
        </li>
      ) : (
        <li><a href={item.href} class="drawer__top">{t(item.label)}</a></li>
      ))}
      <li><a href="/lien-he/" class="drawer__top">{lang === 'en' ? 'Contact' : 'Liên hệ'}</a></li>
    </ul>
    <div class="drawer__cta">
      <a href="/bao-gia/" class="btn btn--primary btn--block">{lang === 'en' ? 'Request a quote' : 'Yêu cầu báo giá'}</a>
      <a href="/ho-so-nang-luc/" class="btn btn--light btn--block">{lang === 'en' ? 'Download company profile' : 'Tải hồ sơ năng lực'}</a>
      <p class="t-caption t-muted mt-16">{site.hotline} · {site.email}</p>
    </div>
  </div>
</div>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: var(--color-snow-white); transition: background-color .35s var(--ease), box-shadow .35s; }
  .header.is-scrolled { background: rgba(252, 252, 247, 0.86); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
  .header--overlay { background: transparent; margin-bottom: calc(var(--header-h) * -1); }
  .header__inner { display: flex; align-items: center; gap: 28px; height: var(--header-h); }
  .header__logo { flex: none; }
  .header__logo :global(.logo__word) { font-size: 22px; }
  .header__actions { display: flex; align-items: center; gap: 18px; margin-left: auto; font-size: 13px; }
  .header__icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; transition: background-color .2s; }
  .header__icon:hover { background: rgba(28,58,19,.07); }
  .header__text-link { transition: opacity .2s; }
  .header__text-link:hover { opacity: .6; }
  .lang { display: inline-flex; gap: 2px; padding: 2px; border-radius: var(--radius-full); border: 1px solid var(--line-dark); }
  .lang a { padding: 3px 8px; border-radius: var(--radius-full); font-size: 11px; font-weight: 500; color: var(--color-pewter); }
  .lang a[aria-current] { background: var(--color-forest-depths); color: var(--color-snow-white); }
  @media (max-width: 560px) { .header__lang, .header__icon { display: none; } }
  .nav { display: none; }
  @media (min-width: 1180px) { .nav { display: block; } }
  .nav__list { display: flex; gap: 2px; }
  .nav__link { display: inline-flex; align-items: center; gap: 5px; height: var(--header-h); padding: 0 10px; font-size: 13.5px; position: relative; }
  .nav__link::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: 20px; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease); }
  .nav__item:hover .nav__link::after, .nav__link:focus-visible::after, .nav__link[aria-current]::after { transform: scaleX(1); }
  .nav__chev { transition: transform .3s var(--ease); opacity: .6; }
  .nav__item:hover .nav__chev, .nav__item:focus-within .nav__chev { transform: rotate(180deg); }

  .mega {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--color-snow-white); border-top: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .3s var(--ease), transform .3s var(--ease), visibility 0s .3s;
  }
  .nav__item.has-mega:hover .mega, .nav__item.has-mega:focus-within .mega {
    opacity: 1; visibility: visible; transform: none; transition: opacity .3s var(--ease), transform .3s var(--ease);
  }
  .nav__item.has-mega.is-closed .mega { opacity: 0; visibility: hidden; }
  .mega__inner { display: grid; grid-template-columns: 200px 1fr 300px; gap: 48px; padding-block: 40px 48px; }
  .mega__groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; }
  .mega__title { margin-bottom: 12px; }
  .mega__link { display: grid; gap: 2px; padding: 8px 0; transition: transform .25s var(--ease); }
  .mega__link span { font-size: 15px; }
  .mega__link small { font-size: var(--text-label); color: var(--color-pewter); }
  .mega__link:hover { transform: translateX(4px); }
  .mega__link:hover span { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .mega__feature { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px; border-radius: var(--radius-cards); background: var(--color-warm-stone); transition: background-color .3s; }
  .mega__feature:hover { background: #e6e6df; }
  .mega__feature-text { color: var(--color-pewter); }

  .burger { width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid var(--line-dark); display: grid; place-items: center; }
  .burger__lines, .burger__lines::before { display: block; width: 16px; height: 1.5px; background: currentColor; position: relative; transition: transform .3s var(--ease); }
  .burger__lines::before { content: ''; position: absolute; top: 5px; }
  .burger__lines { transform: translateY(-2.5px); }
  .burger[aria-expanded='true'] .burger__lines { transform: rotate(45deg); }
  .burger[aria-expanded='true'] .burger__lines::before { transform: translateY(-5px) rotate(-90deg); }
  @media (min-width: 1180px) { .burger { display: none; } }
  @media (max-width: 1179px) { .header__profile { display: none; } }
  @media (max-width: 400px) { .header__actions .btn--primary { padding-inline: 14px; font-size: 13px; } }

  .drawer { position: fixed; inset: var(--header-h) 0 0 0; z-index: 49; background: var(--color-snow-white); overflow-y: auto; }
  .drawer__inner { padding: 8px var(--page-gutter) 40px; display: grid; gap: 32px; }
  .drawer__list > li { border-bottom: 1px solid var(--line-dark); }
  .drawer__top { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; font-size: 22px; font-weight: 300; letter-spacing: -0.02em; cursor: pointer; list-style: none; }
  .drawer__top::-webkit-details-marker { display: none; }
  details > .drawer__top::after { content: '+'; font-size: 20px; transition: transform .3s; }
  details[open] > .drawer__top::after { transform: rotate(45deg); }
  .drawer__sub { padding: 0 0 18px; display: grid; gap: 4px; }
  .drawer__sub a { display: block; padding: 8px 0; color: var(--color-pewter); }
  .drawer__cta { display: grid; gap: 8px; }
</style>
