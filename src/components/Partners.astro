---
import { partners } from '../data/content';
interface Props { title?: string }
const { title = 'Được tin chọn bởi 60+ thương hiệu tại 14 quốc gia' } = Astro.props;
---
<div class="partners">
  <p class="t-mono t-muted partners__title">{title}</p>
  <div class="marquee" role="group" aria-label="Đối tác tiêu biểu / Selected partners">
    <ul class="marquee__track">
      {[...partners, ...partners].map((p, i) => <li aria-hidden={i >= partners.length ? 'true' : undefined}>{p}</li>)}
    </ul>
  </div>
</div>

<style>
  .partners { display: grid; gap: 28px; }
  .partners__title { text-align: center; }
  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee__track { display: flex; gap: 72px; width: max-content; animation: marquee 40s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__track li { font-size: clamp(22px, 2.4vw, 30px); font-weight: 300; letter-spacing: -0.03em; white-space: nowrap; opacity: .7; }
  .marquee__track li:nth-child(3n) { font-family: var(--font-mono); font-size: clamp(16px, 1.8vw, 22px); letter-spacing: 0.08em; }
  .marquee__track li:nth-child(4n) { font-weight: 500; letter-spacing: 0.12em; font-size: clamp(16px, 1.8vw, 22px); }
  @keyframes marquee { to { transform: translateX(calc(-50% - 36px)); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; gap: 24px 48px; } .marquee { mask-image: none; -webkit-mask-image: none; } .marquee__track li[aria-hidden] { display: none; } }
</style>
