---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const all = [{ label: 'Trang chủ', href: '/' }, ...items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, item: it.href ? new URL(it.href, Astro.site).href : undefined })),
};
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((it, i) => (
      <li>
        {it.href && i < all.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.015em; color: var(--color-pewter); }
  .crumbs li + li::before { content: '/'; margin-right: 8px; opacity: .5; }
  .crumbs a:hover { color: var(--color-forest-depths); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { color: var(--color-forest-depths); }
  :global(.section--dark) .crumbs, :global(.on-dark) .crumbs { color: rgba(252,252,247,.6); }
  :global(.section--dark) .crumbs [aria-current], :global(.on-dark) .crumbs [aria-current] { color: var(--color-snow-white); }
</style>
