---
import { keyStats } from '../data/site';
interface Props { items?: { value: number; suffix?: string; label: string }[] }
const { items = keyStats } = Astro.props;
const fmt = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 1, minimumFractionDigits: String(n).includes('.') ? 1 : 0 });
---
<dl class="stats">
  {items.map((s, i) => (
    <div class="stat reveal" style={`--d:${i * 0.07}s`}>
      <dt class="visually-hidden">{s.label}</dt>
      <dd style="margin:0">
        <span class="stat__value"><span data-count={s.value}>{fmt(s.value)}</span>{s.suffix && <small>{s.suffix}</small>}</span>
        <span class="stat__label" aria-hidden="true">{s.label}</span>
      </dd>
    </div>
  ))}
</dl>
<style>
  .stat dd { display: grid; }
</style>
