---
// Minh hoạ line-art đơn sắc (currentColor) theo tinh thần "scientific illustration" của DESIGN.md.
// Dùng làm placeholder sang trọng cho tới khi có ảnh/video thật của sản phẩm & nhà máy.
export type ArtName = 'fan' | 'aircon' | 'induction' | 'hood' | 'heater' | 'purifier' | 'factory' | 'lab' | 'globe' | 'circuit' | 'qc' | 'cert' | 'supply' | 'people' | 'leaf' | 'blueprint' | 'camera360';

interface Props { name: ArtName; class?: string; draw?: boolean; label?: string }
const { name, class: cls = '', draw = true, label } = Astro.props;
---
<svg
  class:list={['art', cls, { draw }]}
  viewBox="0 0 400 300"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  preserveAspectRatio="xMidYMid meet"
>
  {name === 'fan' && (
    <g>
      <circle cx="200" cy="112" r="74" />
      <circle cx="200" cy="112" r="66" opacity=".45" />
      {Array.from({ length: 24 }).map((_, i) => {
        const a = (i / 24) * Math.PI * 2;
        return <line x1={200 + Math.cos(a) * 18} y1={112 + Math.sin(a) * 18} x2={200 + Math.cos(a) * 74} y2={112 + Math.sin(a) * 74} opacity=".22" />;
      })}
      {Array.from({ length: 5 }).map((_, i) => (
        <path transform={`rotate(${i * 72} 200 112)`} d="M200 112 C 214 92, 236 70, 228 54 C 220 42, 198 52, 194 70 C 191 84, 196 100, 200 112 Z" />
      ))}
      <circle cx="200" cy="112" r="11" />
      <circle cx="200" cy="112" r="4" />
      <path d="M200 186 L200 252" />
      <path d="M194 186 L194 252 M206 186 L206 252" opacity=".35" />
      <ellipse cx="200" cy="262" rx="58" ry="10" />
      <ellipse cx="200" cy="258" rx="40" ry="5" opacity=".4" />
      <circle cx="200" cy="232" r="2.5" />
    </g>
  )}

  {name === 'aircon' && (
    <g>
      <rect x="60" y="78" width="280" height="92" rx="18" />
      <path d="M60 136 H340" opacity=".4" />
      <path d="M78 150 H322 M86 160 H314" />
      <circle cx="316" cy="100" r="3" />
      <path d="M292 100 H304" opacity=".5" />
      <rect x="86" y="96" width="44" height="10" rx="5" opacity=".5" />
      {[0, 1, 2, 3, 4].map((i) => (
        <path d={`M${110 + i * 45} 186 C ${100 + i * 45} 206, ${124 + i * 45} 220, ${112 + i * 45} 244`} opacity={0.75 - i * 0.08} />
      ))}
      {[0, 1, 2, 3].map((i) => (
        <circle cx={132 + i * 45} cy={258 - (i % 2) * 8} r="1.8" opacity=".6" />
      ))}
      <path d="M200 40 v20 M190 50 h20 M193 43 l14 14 M207 43 l-14 14" opacity=".55" />
    </g>
  )}

  {name === 'induction' && (
    <g>
      <path d="M70 92 L330 92 L362 232 L38 232 Z" />
      <path d="M76 100 L324 100" opacity=".25" />
      <ellipse cx="140" cy="158" rx="70" ry="38" />
      <ellipse cx="140" cy="158" rx="52" ry="28" opacity=".6" />
      <ellipse cx="140" cy="158" rx="32" ry="17" opacity=".4" />
      <ellipse cx="268" cy="158" rx="56" ry="30" />
      <ellipse cx="268" cy="158" rx="38" ry="20" opacity=".55" />
      <path d="M150 214 H250" />
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <circle cx={154 + i * 12} cy="214" r="1.6" opacity={i < 5 ? 1 : 0.35} />)}
      <circle cx="300" cy="214" r="5" />
      <path d="M38 232 L38 242 L362 242 L362 232" opacity=".45" />
      <path d="M126 70 c -8 -10 8 -16 0 -28 M140 74 c -8 -10 8 -16 0 -28 M154 70 c -8 -10 8 -16 0 -28" opacity=".5" />
    </g>
  )}

  {name === 'hood' && (
    <g>
      <rect x="172" y="28" width="56" height="108" rx="2" />
      <path d="M186 28 V136 M214 28 V136" opacity=".2" />
      <path d="M118 136 H282 L320 196 H80 Z" />
      <path d="M80 196 H320 V206 H80 Z" />
      <path d="M104 206 V212 M296 206 V212" opacity=".4" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M${126 + i * 24} 160 L${118 + i * 26} 186`} opacity=".25" />)}
      <circle cx="292" cy="186" r="2" />
      <circle cx="280" cy="186" r="2" />
      <path d="M140 270 c -10 -14 10 -22 0 -40 M200 274 c -10 -14 10 -22 0 -40 M260 270 c -10 -14 10 -22 0 -40" opacity=".5" />
      <path d="M150 220 L170 230 M250 220 L230 230" opacity=".35" />
    </g>
  )}

  {name === 'heater' && (
    <g>
      <rect x="128" y="40" width="144" height="200" rx="30" />
      <rect x="140" y="52" width="120" height="176" rx="22" opacity=".35" />
      <circle cx="200" cy="112" r="30" />
      <circle cx="200" cy="112" r="22" opacity=".45" />
      <path d="M200 112 L214 98" />
      {Array.from({ length: 11 }).map((_, i) => {
        const a = Math.PI * (0.8 + (i / 10) * 1.4);
        return <line x1={200 + Math.cos(a) * 24} y1={112 + Math.sin(a) * 24} x2={200 + Math.cos(a) * 28} y2={112 + Math.sin(a) * 28} />;
      })}
      <path d="M178 168 H222 M178 180 H210" opacity=".5" />
      <circle cx="230" cy="174" r="3" />
      <path d="M180 240 V268 M220 240 V268" />
      <path d="M180 268 c 0 10 -20 10 -20 0 M220 268 c 0 10 20 10 20 0" opacity=".5" />
      <path d="M96 90 c 8 10 -8 18 0 30 M304 90 c 8 10 -8 18 0 30" opacity=".35" />
    </g>
  )}

  {name === 'purifier' && (
    <g>
      <rect x="146" y="60" width="108" height="200" rx="40" />
      <circle cx="200" cy="104" r="22" />
      {Array.from({ length: 12 }).map((_, i) => <path d={`M164 ${150 + i * 8} H236`} opacity=".3" />)}
    </g>
  )}

  {name === 'factory' && (
    <g>
      <path d="M30 236 V120 L80 92 V120 L130 92 V120 L180 92 V120 L230 92 V120 L280 92 V236" />
      <path d="M280 236 V60 H306 V236 M318 236 V40 H340 V236" />
      <path d="M306 72 H318 M306 100 H318" opacity=".3" />
      <path d="M20 236 H380" />
      {[0, 1, 2, 3, 4].map((i) => <rect x={44 + i * 48} y="150" width="28" height="20" rx="2" opacity=".55" />)}
      <path d="M40 212 H272" />
      <path d="M40 222 H272" opacity=".4" />
      {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <circle cx={48 + i * 32} cy="217" r="4" opacity=".5" />)}
      {[0, 1, 2].map((i) => <rect x={70 + i * 70} y="194" width="22" height="18" rx="2" />)}
      <path d="M232 212 V186 L250 170 L270 178" />
      <circle cx="250" cy="170" r="4" />
      <path d="M270 178 l8 -2 M270 178 l6 6" />
      <path d="M329 40 c 0 -12 14 -12 14 -24 M293 60 c 0 -10 12 -10 12 -20" opacity=".35" />
    </g>
  )}

  {name === 'lab' && (
    <g>
      <rect x="44" y="60" width="200" height="140" rx="12" />
      {Array.from({ length: 9 }).map((_, i) => <path d={`M${44 + (i + 1) * 20} 60 V200`} opacity=".12" />)}
      {Array.from({ length: 6 }).map((_, i) => <path d={`M44 ${60 + (i + 1) * 20} H244`} opacity=".12" />)}
      <path d="M44 130 C 64 70, 84 70, 104 130 S 144 190, 164 130 S 204 70, 224 130 L244 130" />
      <path d="M44 150 L84 150 L94 110 L106 170 L116 150 L244 150" opacity=".45" />
      <path d="M300 92 V150 L332 214 C 336 224, 330 232, 320 232 H260 C 250 232, 244 224, 248 214 L280 150 V92" />
      <path d="M292 92 H308 M272 92 H288" />
      <path d="M262 198 H318" opacity=".5" />
      <circle cx="284" cy="214" r="3" opacity=".6" />
      <circle cx="300" cy="206" r="2" opacity=".6" />
      <path d="M60 230 H230" opacity=".4" />
      <circle cx="74" cy="230" r="5" />
      <circle cx="96" cy="230" r="5" />
    </g>
  )}

  {name === 'globe' && (
    <g>
      <circle cx="200" cy="150" r="100" />
      <ellipse cx="200" cy="150" rx="44" ry="100" opacity=".45" />
      <ellipse cx="200" cy="150" rx="80" ry="100" opacity=".25" />
      <path d="M100 150 H300 M114 100 H286 M114 200 H286" opacity=".3" />
      <path d="M150 128 C 190 60, 250 70, 276 110" stroke-dasharray="3 5" />
      <path d="M150 128 C 170 200, 230 220, 262 196" stroke-dasharray="3 5" />
      <path d="M150 128 C 120 180, 140 220, 164 230" stroke-dasharray="3 5" />
      <circle cx="150" cy="128" r="5" fill="currentColor" />
      <circle cx="276" cy="110" r="3.5" />
      <circle cx="262" cy="196" r="3.5" />
      <circle cx="164" cy="230" r="3.5" />
      <circle cx="150" cy="128" r="12" opacity=".4" />
    </g>
  )}

  {name === 'circuit' && (
    <g>
      <path d="M0 220 H90 L120 190 H210 L240 160 H400" />
      <path d="M0 250 H130 L150 230 H260 L290 260 H400" opacity=".5" />
      <path d="M60 300 V260 L90 230 V220" opacity=".5" />
      <path d="M210 190 V120 L250 80 H340 L370 50 V0" />
      <path d="M150 230 V150 L180 120 H210" opacity=".5" />
      <path d="M290 160 V110 L320 80" opacity=".5" />
      <path d="M120 190 V100 L160 60 H230 L260 30 V0" opacity=".35" />
      <path d="M340 160 V200 L370 230 H400" opacity=".4" />
      {[[90, 220], [210, 190], [240, 160], [150, 230], [260, 230], [250, 80], [340, 80], [160, 60], [290, 160], [370, 230], [180, 120], [320, 80]].map(([x, y]) => (
        <circle cx={x} cy={y} r="3.5" />
      ))}
      <rect x="196" y="134" width="28" height="28" rx="4" opacity=".7" />
    </g>
  )}

  {name === 'qc' && (
    <g>
      <circle cx="170" cy="140" r="70" />
      <circle cx="170" cy="140" r="56" opacity=".35" />
      <path d="M220 190 L280 250" stroke-width="2" />
      <path d="M140 140 L162 162 L204 118" stroke-width="1.6" />
      {Array.from({ length: 6 }).map((_, i) => <path d={`M300 ${70 + i * 18} H350`} opacity={i === 2 ? 1 : 0.35} />)}
      <circle cx="292" cy="106" r="3" fill="currentColor" />
    </g>
  )}

  {name === 'cert' && (
    <g>
      <rect x="100" y="40" width="200" height="220" rx="10" />
      <path d="M130 80 H270 M130 100 H250 M130 120 H260" opacity=".45" />
      <circle cx="200" cy="184" r="36" />
      <circle cx="200" cy="184" r="28" opacity=".4" />
      {Array.from({ length: 16 }).map((_, i) => {
        const a = (i / 16) * Math.PI * 2;
        return <line x1={200 + Math.cos(a) * 36} y1={184 + Math.sin(a) * 36} x2={200 + Math.cos(a) * 41} y2={184 + Math.sin(a) * 41} />;
      })}
      <path d="M186 184 l10 10 l18 -20" stroke-width="1.5" />
      <path d="M180 218 L172 262 L188 252 L198 266 L200 220 M220 218 L228 262 L212 252 L202 266" opacity=".6" />
    </g>
  )}

  {name === 'supply' && (
    <g>
      <path d="M40 210 H240 V140 H290 L330 180 V210 H360" />
      <path d="M40 210 V120 H240" opacity=".6" />
      {[0, 1, 2, 3].map((i) => <path d={`M${60 + i * 46} 120 V210`} opacity=".25" />)}
      <circle cx="90" cy="220" r="14" />
      <circle cx="280" cy="220" r="14" />
      <circle cx="90" cy="220" r="5" opacity=".5" />
      <circle cx="280" cy="220" r="5" opacity=".5" />
      <path d="M252 152 H282 L304 176 H252 Z" opacity=".5" />
      <path d="M20 250 H380" opacity=".35" stroke-dasharray="4 8" />
      <path d="M60 70 H120 V100 H60 Z M130 70 H190 V100 H130 Z M95 40 H155 V70 H95 Z" opacity=".55" />
    </g>
  )}

  {name === 'people' && (
    <g>
      {[[120, 1], [200, 0], [280, 1]].map(([x, o]) => (
        <g opacity={o ? 0.6 : 1}>
          <circle cx={x} cy={o ? 118 : 104} r={o ? 22 : 28} />
          <path d={`M${x - (o ? 46 : 56)} ${o ? 230 : 240} C ${x - (o ? 46 : 56)} ${o ? 176 : 164}, ${x + (o ? 46 : 56)} ${o ? 176 : 164}, ${x + (o ? 46 : 56)} ${o ? 230 : 240}`} />
        </g>
      ))}
      <path d="M60 250 H340" opacity=".35" />
    </g>
  )}

  {name === 'leaf' && (
    <g>
      <path d="M200 260 C 120 220, 100 120, 200 40 C 300 120, 280 220, 200 260 Z" />
      <path d="M200 260 V60" />
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <g opacity=".5">
          <path d={`M200 ${220 - i * 28} L${160 - i * 2} ${190 - i * 28}`} />
          <path d={`M200 ${220 - i * 28} L${240 + i * 2} ${190 - i * 28}`} />
        </g>
      ))}
    </g>
  )}

  {name === 'blueprint' && (
    <g>
      <rect x="40" y="40" width="320" height="220" rx="8" opacity=".4" />
      {Array.from({ length: 15 }).map((_, i) => <path d={`M${40 + (i + 1) * 20} 40 V260`} opacity=".1" />)}
      {Array.from({ length: 10 }).map((_, i) => <path d={`M40 ${40 + (i + 1) * 20} H360`} opacity=".1" />)}
      <circle cx="170" cy="150" r="64" />
      <circle cx="170" cy="150" r="10" />
      <path d="M170 70 V54 M170 230 V246 M90 150 H74" opacity=".5" />
      <path d="M106 54 H234" opacity=".6" />
      <path d="M106 50 V58 M234 50 V58" opacity=".6" />
      <text x="150" y="46" font-size="9" fill="currentColor" stroke="none" font-family="monospace">Ø 400</text>
      <path d="M260 90 H330 V210 H260 Z" />
      <path d="M260 120 H330 M260 150 H330 M260 180 H330" opacity=".35" />
      <path d="M170 150 L215 105" stroke-dasharray="3 4" />
    </g>
  )}

  {name === 'camera360' && (
    <g>
      <ellipse cx="200" cy="150" rx="150" ry="50" />
      <ellipse cx="200" cy="150" rx="150" ry="50" transform="rotate(90 200 150)" opacity=".2" />
      <circle cx="200" cy="150" r="34" />
      <path d="M190 136 L216 150 L190 164 Z" />
      <path d="M340 140 l10 10 l-14 4" />
    </g>
  )}
</svg>

<style>
  .art { width: 100%; height: auto; overflow: visible; }
</style>
