---
import NewsCard from './NewsCard.astro';
import { newsCategories, type Post } from '../data/content';
interface Props { posts: Post[]; active?: string }
const { posts, active } = Astro.props;
const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));
const [first, ...rest] = sorted;
---
<nav class="tabs" aria-label="Chuyên mục tin tức">
  <a href="/tin-tuc/" aria-current={!active ? 'page' : undefined}>Tất cả</a>
  {newsCategories.map((c) => <a href={`/tin-tuc/chuyen-muc/${c.slug}/`} aria-current={active === c.slug ? 'page' : undefined}>{c.name}</a>)}
</nav>
{first ? (
  <div class="list">
    <NewsCard post={first} large />
    <div class="grid grid-3 mt-64">{rest.map((p, i) => <NewsCard post={p} index={i} />)}</div>
  </div>
) : <p class="t-muted">Chưa có bài viết trong chuyên mục này.</p>}
<style>
  .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 48px; }
  .tabs a { padding: 10px 18px; border-radius: var(--radius-full); border: 1.5px solid var(--line-dark); font-size: var(--text-caption); transition: all .25s var(--ease); }
  .tabs a:hover { border-color: var(--color-forest-depths); }
  .tabs a[aria-current] { background: var(--color-forest-depths); border-color: var(--color-forest-depths); color: var(--color-snow-white); }
  .list :global(.ncard--large .ncard__link) { display: grid; gap: 32px; }
  @media (min-width: 960px) { .list :global(.ncard--large .ncard__link) { grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; } }
</style>
