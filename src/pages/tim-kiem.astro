---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { buildSearchIndex } from '../data/search';
const suggestions = ['Quạt BLDC', 'Bếp từ', 'MOQ', 'ODM', 'Chứng nhận CE', 'Điều hoà Inverter'];
---
<Base title="Tìm kiếm" description="Tìm kiếm ngành hàng, mẫu sản phẩm và bài viết trên website Homichi." noindex>
  <section class="search">
    <div class="container container--narrow">
      <Breadcrumb items={[{ label: 'Tìm kiếm' }]} />
      <h1 class="t-display mt-48">Bạn đang tìm gì?</h1>
      <form class="search__form" role="search" data-search>
        <label for="q" class="visually-hidden">Từ khoá</label>
        <Icon name="search" size={22} />
        <input id="q" name="q" type="search" class="search__input" placeholder="Ngành hàng, mã sản phẩm, bài viết…" autocomplete="off" autofocus />
      </form>
      <div class="search__chips">
        {suggestions.map((s) => <a href={`/tim-kiem/?q=${encodeURIComponent(s)}`} class="pill">{s}</a>)}
      </div>
      <p class="t-mono t-muted search__count" data-count aria-live="polite"></p>
      <ul class="results" data-results></ul>
      <script type="application/json" id="search-data" set:html={JSON.stringify(buildSearchIndex())} />
    </div>
  </section>
</Base>
<script>
  // bản sao nhỏ của scripts/url.ts để script này tự chứa (được nhúng thẳng vào HTML)
  const href = (path: string) => {
    const root = document.documentElement.dataset.root;
    if (root == null || !path.startsWith('/')) return path;
    return root + path.slice(1).replace(/(^|\/)(\?|#|$)/, '$1index.html$2');
  };
  const form = document.querySelector<HTMLFormElement>('[data-search]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const list = document.querySelector<HTMLUListElement>('[data-results]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  type Item = { t: string; d: string; u: string; k: string };
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let data: Item[] = [];
  const render = () => {
    const q = norm(input.value.trim());
    if (!q) { list.innerHTML = ''; count.textContent = ''; return; }
    const terms = q.split(/\s+/);
    const res = data
      .map((it) => { const h = norm(`${it.t} ${it.d} ${it.k}`); const score = terms.reduce((s, t) => s + (h.includes(t) ? (norm(it.t).includes(t) ? 2 : 1) : -99), 0); return { it, score }; })
      .filter((r) => r.score > 0).sort((a, b) => b.score - a.score).map((r) => r.it);
    count.textContent = `${res.length} kết quả cho “${input.value.trim()}”`;
    list.innerHTML = res.length
      ? res.map((r) => `<li><a href="${href(r.u)}" class="result"><span class="t-mono t-muted">${esc(r.k)}</span><span class="t-subheading">${esc(r.t)}</span><span class="t-caption t-muted">${esc(r.d)}</span></a></li>`).join('')
      : `<li class="t-muted">Không tìm thấy kết quả. Thử từ khoá khác hoặc <a href="${href('/lien-he/')}" style="border-bottom:1px solid">liên hệ chúng tôi</a>.</li>`;
  };
  data = JSON.parse(document.getElementById('search-data')?.textContent || '[]');
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0) input.value = q0;
  render();
  input.addEventListener('input', () => { render(); const u = new URL(location.href); u.searchParams.set('q', input.value); history.replaceState(null, '', u); });
  form.addEventListener('submit', (e) => e.preventDefault());
</script>
<style>
  .search { padding-block: 32px var(--section-pad); min-height: 70vh; }
  .search__form { display: flex; align-items: center; gap: 16px; margin-top: 32px; padding: 0 24px; border-radius: var(--radius-full); border: 1.5px solid var(--color-forest-depths); }
  .search__input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 20px 0; font-size: 20px; font-weight: 300; outline: none; }
  .search__form:focus-within { outline: 2px solid var(--color-lime-pulse); outline-offset: 2px; }
  .search__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .search__chips .pill:hover { background: var(--color-forest-depths); color: var(--color-snow-white); border-color: var(--color-forest-depths); }
  .search__count { margin-top: 48px; }
  .results { margin-top: 16px; border-top: 1px solid var(--line-dark); }
  .results :global(.result) { display: grid; gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--line-dark); transition: padding .3s var(--ease); }
  .results :global(.result:hover) { padding-left: 8px; }
  .results :global(li.t-muted) { padding: 22px 0; }
</style>
