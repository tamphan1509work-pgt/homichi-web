---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Icon from '../components/Icon.astro';
const links = [['Sản phẩm', '/san-pham/'], ['Dịch vụ ODM/OEM', '/dich-vu/'], ['Năng lực sản xuất', '/ve-homichi/nang-luc/'], ['Liên hệ', '/lien-he/']];
---
<Base title="Không tìm thấy trang" description="Trang bạn tìm không tồn tại." noindex>
  <section class="nf">
    <div class="container nf__grid">
      <div class="stack" style="--stack:24px">
        <p class="eyebrow">Lỗi 404</p>
        <h1 class="t-hero">Trang này đã rời dây chuyền.</h1>
        <p class="t-body t-muted mw-560">Đường dẫn có thể đã thay đổi hoặc không còn tồn tại. Hãy thử một trong các trang dưới đây.</p>
        <ul class="nf__links">{links.map(([l, h]) => <li><a href={h}>{l} <Icon name="arrow" size={16} /></a></li>)}</ul>
        <div class="btn-row"><a href="/" class="btn btn--primary">Về trang chủ</a><a href="/tim-kiem/" class="btn btn--light">Tìm kiếm <Icon name="search" size={16} /></a></div>
      </div>
      <div class="nf__art" aria-hidden="true"><span>404</span><Art name="qc" /></div>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(64px, 10vw, 140px); }
  .nf__grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 960px) { .nf__grid { grid-template-columns: 1.1fr .9fr; } }
  .nf__links { border-top: 1px solid var(--line-dark); }
  .nf__links a { display: flex; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--line-dark); font-size: var(--text-body); }
  .nf__art { position: relative; aspect-ratio: 1; border-radius: var(--radius-large-cards); background: var(--color-warm-stone); display: grid; place-items: center; padding: 16%; }
  .nf__art span { position: absolute; left: 24px; top: 16px; font-size: 72px; font-weight: 300; letter-spacing: -0.05em; }
</style>
