---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsList from '../../components/NewsList.astro';
import { posts } from '../../data/content';
---
<Base title="Tin tức & sự kiện" description="Tin tức doanh nghiệp, lịch hội chợ triển lãm và kiến thức ODM/OEM từ Homichi.">
  <PageHero eyebrow="Tin tức & sự kiện" title="Câu chuyện từ nhà máy Homichi." crumbs={[{ label: 'Tin tức' }]} />
  <section class="section section--tight"><div class="container"><NewsList posts={posts} /></div></section>
</Base>
