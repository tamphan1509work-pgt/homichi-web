---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Frame from '../../components/Frame.astro';
import CTA from '../../components/CTA.astro';
// Cần Homichi chốt danh sách thương hiệu thành viên được công khai (theo sitemap: KHÔNG đưa Chillami).
const members = [
  { name: 'Homichi Manufacturing', code: 'HM-MFG', role: 'Nhà máy ODM/OEM', text: 'Đơn vị cốt lõi: R&D, khuôn mẫu, sản xuất và kiểm định thiết bị điện gia dụng cho thương hiệu đối tác.', art: 'factory', tone: 'dark' },
  { name: 'Homichi Components', code: 'HM-CMP', role: 'Động cơ & bo mạch', text: 'Sản xuất động cơ BLDC/AC, bo mạch điều khiển và module IoT — cung cấp cho nhà máy và đối tác bên ngoài.', art: 'circuit', tone: 'sage' },
  { name: 'Homichi Tooling', code: 'HM-TL', role: 'Khuôn mẫu chính xác', text: 'Thiết kế & chế tạo khuôn ép nhựa, khuôn dập kim loại với độ chính xác ±0,01 mm.', art: 'blueprint', tone: 'frost' },
  { name: 'Homichi Living', code: 'HM-LV', role: 'Thương hiệu bán lẻ', text: 'Thương hiệu gia dụng của chính Homichi — nơi thử nghiệm công nghệ mới trước khi chuyển giao cho đối tác.', art: 'fan', tone: 'eucalyptus' },
] as const;
---
<Base title="Hệ sinh thái & thương hiệu thành viên" description="Hệ sinh thái các đơn vị thành viên của Homichi — minh chứng cho năng lực làm chủ chuỗi giá trị.">
  <PageHero eyebrow="Hệ sinh thái" title="Một hệ sinh thái làm chủ chuỗi giá trị, từ linh kiện đến thành phẩm." lead="Các đơn vị thành viên giúp Homichi kiểm soát chất lượng và chi phí ở từng công đoạn — lợi thế được chuyển trực tiếp tới đối tác." crumbs={[{ label: 'Về Homichi', href: '/ve-homichi/' }, { label: 'Hệ sinh thái' }]} />
  <section class="section section--tight">
    <div class="container">
      <div class="grid grid-2">
        {members.map((m, i) => (
          <article class="card member reveal" style={`--d:${(i % 2) * 0.08}s`}>
            <Frame art={m.art} tone={m.tone} ratio="wide" />
            <div class="member__body">
              <div class="flex justify-between items-center wrap gap-8"><span class="pill">{m.code}</span><span class="t-mono t-muted">{m.role}</span></div>
              <h2 class="t-heading-sm">{m.name}</h2>
              <p class="t-muted">{m.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--stone">
    <div class="container">
      <SectionHead eyebrow="Lợi ích cho đối tác" title="Vì sao hệ sinh thái quan trọng với thương hiệu của bạn?" />
      <div class="grid grid-3">
        {[
          ['−15%', 'chi phí BOM nhờ tự sản xuất động cơ, bo mạch và khuôn'],
          ['−30%', 'thời gian phát triển khi R&D và khuôn mẫu cùng một nơi'],
          ['100%', 'linh kiện chính truy xuất được nguồn gốc'],
        ].map(([v, l], i) => (
          <div class="benefit reveal" style={`--d:${i * 0.06}s`}><p class="benefit__v">{v}</p><p class="t-muted">{l}</p></div>
        ))}
      </div>
    </div>
  </section>
  <CTA />
</Base>
<style>
  .member { padding: 12px 12px 28px; }
  .member__body { display: grid; gap: 14px; padding: 12px 16px 0; }
  .benefit { padding-top: 24px; border-top: 1.5px solid var(--color-forest-depths); display: grid; gap: 8px; }
  .benefit__v { font-size: clamp(48px, 6vw, 72px); font-weight: 300; letter-spacing: -0.05em; line-height: 1; }
</style>
