---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { faqs } from '../../data/content';
import { site } from '../../data/site';

// Rich result SEO: FAQPage
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="Câu hỏi thường gặp" description="Giải đáp các câu hỏi thường gặp về MOQ, thời gian sản xuất, ODM/OEM, chứng nhận, thanh toán và bảo hành khi hợp tác với Homichi." jsonLd={faqLd}>
  <PageHero eyebrow="Câu hỏi thường gặp" title="Những điều đối tác thường hỏi trước khi bắt đầu." crumbs={[{ label: 'Dịch vụ ODM/OEM', href: '/dich-vu/' }, { label: 'Câu hỏi thường gặp' }]} />
  <section class="section section--tight">
    <div class="container">
      <div class="faq">
        <aside class="faq__aside">
          <div class="card">
            <p class="t-subheading">Chưa tìm thấy câu trả lời?</p>
            <p class="t-caption t-muted">Đội ngũ kinh doanh phản hồi trong vòng 4 giờ làm việc.</p>
            <a href="/lien-he/" class="btn btn--primary btn--sm">Liên hệ chúng tôi</a>
            <a href={site.hotlineHref} class="link-arrow">Hotline {site.hotline}</a>
          </div>
        </aside>
        <div class="accordion">
          {faqs.map((f, i) => (
            <details open={i === 0} class="reveal" style={`--d:${Math.min(i, 4) * 0.04}s`}>
              <summary>{f.q}</summary>
              <div class="accordion__body"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
  <CTA />
</Base>
<style>
  .faq { display: grid; gap: 48px; }
  @media (min-width: 960px) { .faq { grid-template-columns: 300px 1fr; gap: 80px; align-items: start; } .faq__aside { position: sticky; top: calc(var(--header-h) + 24px); order: 2; } }
  .faq__aside .card { align-items: flex-start; }
</style>
