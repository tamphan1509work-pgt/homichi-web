---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/products';
import { caseStudies, posts, partners } from '../data/content';
import { keyStats } from '../data/site';

const productImg: Record<string, string> = { fan: 'fan', aircon: 'aircon', induction: 'induction', hood: 'hood', heater: 'heater' };
const badges = ['Bán chạy', 'Mới', 'Tiết kiệm 5★', 'Dự án', 'Mới'];
const latest = [...posts].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 1, minimumFractionDigits: String(n).includes('.') ? 1 : 0 });
---
<Base title="Homichi — Nhà sản xuất ODM/OEM thiết bị điện gia dụng" altHref="/en/" overlayHeader>
  <!-- 1. HERO: ảnh toàn khung, tiêu đề bên trái -->
  <section class="hero">
    <img class="hero__img" src="/images/hero.webp" alt="Bộ sưu tập thiết bị gia dụng do Homichi sản xuất: quạt điện, bình nước nóng và bếp từ" fetchpriority="high" />
    <div class="container container--wide hero__inner">
      <div class="hero__text">
        <h1 class="t-hero t-balance">Thiết bị gia dụng chuẩn quốc tế, sản xuất cho thương hiệu của bạn.</h1>
        <p class="hero__lead">Nhà máy ODM/OEM 62.000 m² tại TP. HCM — thiết kế, phát triển và sản xuất quạt điện, điều hoà, bếp từ, máy hút mùi, bình nước nóng cho hơn 60 thương hiệu.</p>
        <div class="hero__actions">
          <a href="/bao-gia/" class="btn btn--primary btn--sm">Yêu cầu báo giá</a>
          <a href="/san-pham/" class="hero__link">Xem sản phẩm <Icon name="arrow" size={13} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NGÀNH HÀNG: sheet xanh đậm trượt lên hero -->
  <section class="section section--dark products">
    <div class="container container--wide">
      <div class="head3">
        <h2 class="t-heading-lg t-balance reveal">Năm ngành hàng, sẵn sàng mang tên thương hiệu của bạn.</h2>
        <p class="t-caption head3__text reveal" style="--d:.05s">Mỗi ngành hàng có dây chuyền chuyên biệt, phòng thử nghiệm riêng và đội kỹ sư hiểu sâu sản phẩm.</p>
        <a href="/san-pham/" class="head3__link reveal" style="--d:.1s">Tất cả sản phẩm <Icon name="arrow" size={13} /></a>
      </div>
      <ul class="pgrid">
        {categories.map((c, i) => (
          <li class="pcard reveal" style={`--d:${i * 0.05}s`}>
            <span class:list={['pcard__badge', { 'pcard__badge--lime': i === 0 || i === 2 }]}>{badges[i]}</span>
            <span class="pill pcard__code">{c.code}-{String(i + 1).padStart(2, '0')}</span>
            <h3 class="pcard__name">{c.name}</h3>
            <img class="pcard__img" src={`/images/${productImg[c.art]}.webp`} alt={c.name} loading="lazy" />
            <a href={`/san-pham/${c.slug}/`} class="pcard__btn">Xem ngành hàng<span class="visually-hidden"> {c.name}</span></a>
            <p class="pcard__meta">Công suất {c.capacity}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. ODM trọn gói: chữ trái, ảnh có chú thích phải + 3 ảnh nhỏ -->
  <section class="section feature">
    <div class="container container--wide feature__grid">
      <div class="feature__text">
        <span class="badge">ODM · Trọn gói</span>
        <h2 class="t-heading t-balance">Từ bản phác thảo đến container xuất khẩu, dưới một mái nhà.</h2>
        <p class="t-caption feature__p">R&D, khuôn mẫu, SMT, lắp ráp và phòng thử nghiệm cùng nằm trong một khuôn viên — tiến độ chủ động, chi phí minh bạch, chất lượng truy xuất được tới từng linh kiện.</p>
        <a href="/dich-vu/odm/" class="btn btn--primary btn--sm">Tìm hiểu dịch vụ ODM</a>
      </div>
      <div class="feature__media">
        <div class="callout reveal">
          <img src="/images/induction.webp" alt="Bếp từ đôi HM-ID72 với nồi men xanh" loading="lazy" />
          <span class="callout__tag" style="--x:30%;--y:16%"><span class="pill">Bo IGBT nội bộ</span><i style="--h:56px"></i></span>
          <span class="callout__tag" style="--x:70%;--y:26%"><span class="pill">Kính Schott Ceran</span><i style="--h:84px"></i></span>
        </div>
        <div class="thumbs">
          <img class="reveal" style="--d:.05s" src="/images/detail-fan.webp" alt="Cận cảnh lồng và cánh quạt BLDC" loading="lazy" />
          <img class="reveal" style="--d:.1s" src="/images/detail-dial.webp" alt="Đồng hồ nhiệt bình nước nóng" loading="lazy" />
          <img class="reveal" style="--d:.15s" src="/images/detail-cooktop.webp" alt="Mặt kính bếp từ và bảng điều khiển cảm ứng" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Dải ảnh toàn khung + kính mờ số liệu -->
  <section class="band">
    <div class="container container--wide">
      <div class="band__frame reveal">
        <img src="/images/line.webp" alt="Dây chuyền lắp ráp bình nước nóng tại nhà máy Homichi" loading="lazy" />
        <div class="glass">
          <div class="glass__item">
            <span class="pill">QC</span>
            <p class="glass__label">Tỉ lệ lỗi xuất xưởng</p>
            <p class="glass__value">&lt; 0,3<small>%</small></p>
          </div>
          {keyStats.slice(1).map((s) => (
            <div class="glass__item">
              <p class="glass__value"><span data-count={s.value}>{fmt(s.value)}</span><small>{s.suffix}</small></p>
              <p class="glass__label">{s.label}</p>
            </div>
          ))}
          <a href="/ve-homichi/nang-luc/" class="glass__link">Năng lực sản xuất <Icon name="arrow" size={13} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Khối "khoa học": chữ trái, minh hoạ trong khung xám phải -->
  <section class="section science">
    <div class="container container--wide science__grid">
      <div class="science__text">
        <p class="science__brand">homichi <span class="bracket">[R&D]</span></p>
        <div class="stack" style="--stack:16px">
          <h2 class="t-heading t-balance">Kỹ thuật nằm bên trong mỗi sản phẩm.</h2>
          <p class="t-caption science__p">85 kỹ sư thiết kế công nghiệp, cơ khí, điện tử và khuôn mẫu. Mô phỏng dòng khí, nhiệt và dòng chảy nhựa trước khi cắt khuôn đầu tiên.</p>
          <a href="/ve-homichi/nang-luc/rd-thiet-ke/" class="btn btn--primary btn--sm science__btn">Khám phá R&D <span class="dot"></span></a>
        </div>
        <p class="science__crumb"><span>NĂNG LỰC</span> / R&D & thiết kế</p>
      </div>
      <div class="science__art reveal"><Art name="blueprint" /></div>
    </div>
  </section>

  <!-- 6. Carousel câu chuyện khách hàng -->
  <section class="section stories">
    <div class="container container--wide">
      <div class="center-head">
        <h2 class="t-heading t-balance">Hơn 60 thương hiệu đã đưa sản phẩm ra thị trường cùng Homichi.</h2>
        <p class="t-caption">Bài toán, giải pháp và kết quả từ những dự án tiêu biểu.</p>
      </div>
    </div>
    <div class="carousel" data-carousel>
      <ul class="carousel__track" data-track>
        {caseStudies.map((c, i) => (
          <li class="slide">
            <a href={`/du-an-doi-tac/${c.slug}/`} class="slide__card">
              <img src={['/images/lineup.webp', '/images/hood.webp', '/images/detail-cooktop.webp'][i]} alt="" loading="lazy" class:list={['slide__img', { 'slide__img--contain': i === 1 }]} />
              <span class="slide__brand">homichi<sup>•</sup></span>
              <span class="slide__title">{c.title}</span>
              <span class="slide__meta">{c.model} · {c.client}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="carousel__ctrl">
        <button type="button" data-prev aria-label="Câu chuyện trước"><Icon name="arrow" size={14} class="flip" /></button>
        <span class="carousel__count" data-count-label>01 / 0{caseStudies.length}</span>
        <button type="button" data-next aria-label="Câu chuyện tiếp theo"><Icon name="arrow" size={14} /></button>
      </div>
    </div>
  </section>

  <!-- 7. Dải ô hình hỗn hợp: tin tức, trích dẫn, ảnh -->
  <section class="section strip">
    <div class="container container--wide">
      <h2 class="t-heading t-balance strip__title">Tin tức từ nhà máy, kỹ sư và đối tác của Homichi.</h2>
    </div>
    <ul class="strip__row">
      <li class="tile tile--img"><img src="/images/detail-fan.webp" alt="" loading="lazy" /><a href={`/tin-tuc/${latest[0].slug}/`} class="tile__cap">{latest[0].title}</a></li>
      <li class="tile tile--dark"><p class="tile__quote">“Chúng tôi không xây nhà máy để cạnh tranh về giá, mà để đối tác tự hào đặt tên mình lên sản phẩm.”</p><span class="tile__src">CEO Homichi</span></li>
      <li class="tile tile--stack">
        <div class="tile__round"><img src="/images/lineup.webp" alt="" loading="lazy" /></div>
        <a href={`/tin-tuc/${latest[1].slug}/`} class="tile__mini">{latest[1].title}<span>{latest[1].read}</span></a>
      </li>
      <li class="tile tile--img"><img src="/images/detail-dial.webp" alt="" loading="lazy" /><a href={`/tin-tuc/${latest[2].slug}/`} class="tile__cap">{latest[2].title}</a></li>
      <li class="tile tile--logos"><p class="tile__label">Đối tác</p><ul>{partners.slice(0, 6).map((p) => <li>{p}</li>)}</ul></li>
      <li class="tile tile--img"><img src="/images/heater.webp" alt="" loading="lazy" class="contain" /><a href={`/tin-tuc/${latest[3].slug}/`} class="tile__cap">{latest[3].title}</a></li>
      <li class="tile tile--sage"><p class="tile__quote">Canton Fair 140 · Gian hàng 15.2 J18</p><a href={`/tin-tuc/${latest.find((p) => p.category === 'hoi-cho-trien-lam')!.slug}/`} class="tile__btn">Đặt lịch gặp</a></li>
    </ul>
  </section>

  <!-- 8. Hai thẻ ảnh lớn -->
  <section class="section duo">
    <div class="container container--wide duo__grid">
      <a href="/ve-homichi/nang-luc/tham-quan-nha-may/" class="duo__card reveal">
        <img src="/images/line.webp" alt="" loading="lazy" />
        <span class="duo__body">
          <span class="duo__title">homichi <span class="bracket">[Factory]</span></span>
          <span class="duo__text">Tham quan nhà máy trực tiếp hoặc trực tuyến 360°.</span>
          <span class="duo__btn">Đặt lịch tham quan</span>
        </span>
      </a>
      <a href="/bao-gia/" class="duo__card duo__card--green reveal" style="--d:.08s">
        <img src="/images/lineup.webp" alt="" loading="lazy" />
        <span class="duo__body">
          <span class="duo__title duo__title--sm">Đưa sản phẩm mang thương hiệu của bạn ra thị trường.</span>
          <span class="duo__text">Phương án kỹ thuật và báo giá sơ bộ trong 48 giờ làm việc.</span>
          <span class="duo__btn">Yêu cầu báo giá</span>
        </span>
      </a>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const label = root.querySelector<HTMLElement>('[data-count-label]');
    let i = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = `translateX(${-slides[i].offsetLeft + slides[0].offsetLeft}px)`;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      if (label) label.textContent = `0${i + 1} / 0${slides.length}`;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(i - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(i + 1));
    window.addEventListener('resize', () => go(i));
    go(0);
  }
</script>

<style>
  /* 1. Hero */
  .hero { position: sticky; top: 0; height: min(92vh, 900px); min-height: 560px; overflow: hidden; display: flex; z-index: 0; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .hero__inner { position: relative; display: flex; align-items: flex-start; padding-top: calc(var(--header-h) + clamp(48px, 10vh, 120px)); }
  .hero__text { display: grid; gap: 18px; max-width: 480px; }
  .hero__lead { font-size: 14px; line-height: 1.55; max-width: 420px; color: var(--color-forest-depths); }
  .hero__actions { display: flex; align-items: center; gap: 18px; margin-top: 6px; }
  .hero__link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  @media (max-width: 720px) {
    .hero { height: auto; min-height: 0; flex-direction: column; position: relative; }
    .hero__img { position: relative; order: 2; height: 300px; object-position: 70% 50%; }
    .hero__inner { padding-top: calc(var(--header-h) + 32px); padding-bottom: 40px; }
  }
  main > section:not(.hero) { z-index: 1; }

  /* 2. Products (dark sheet) */
  .head3 { display: grid; gap: 16px; margin-bottom: 40px; align-items: end; }
  @media (min-width: 960px) { .head3 { grid-template-columns: 1fr 0.8fr auto; gap: 48px; } }
  .head3 h2 { max-width: 520px; }
  .head3__text { color: rgba(252,252,247,.75); max-width: 360px; }
  .head3__link, .center-head a { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; border-bottom: 1px solid currentColor; justify-self: start; padding-bottom: 2px; }
  .pgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 12px; }
  @media (max-width: 720px) { .pgrid { grid-template-columns: repeat(2, 1fr); gap: 8px; } .pcard { padding: 14px 10px 16px; } .pcard__code { margin-top: 20px; } }
  .pcard { position: relative; display: grid; justify-items: center; gap: 10px; padding: 18px 16px 20px; border-radius: var(--radius-cards); background: #284a1f; text-align: center; transition: background-color .3s var(--ease); }
  .pcard:hover { background: #2f5525; }
  .pcard__badge { position: absolute; left: 12px; top: 12px; padding: 3px 7px; border-radius: var(--radius-full); background: var(--color-olive-gold); color: var(--color-forest-depths); font-size: 10px; font-weight: 500; }
  .pcard__badge--lime { background: var(--color-lime-pulse); }
  .pcard__code { font-size: 10px; padding: 4px 8px; margin-top: 18px; border-width: 1px; }
  .pcard__name { font-size: 15px; font-weight: 400; letter-spacing: -0.01em; }
  .pcard__img { width: 100%; aspect-ratio: 1; object-fit: contain; margin-block: 4px; transition: transform .6s var(--ease); filter: saturate(1.05); }
  .pcard:hover .pcard__img { transform: translateY(-4px) scale(1.03); }
  .pcard__btn { padding: 8px 14px; border-radius: var(--radius-full); background: var(--color-snow-white); color: var(--color-forest-depths); font-size: 12px; transition: background-color .25s; }
  .pcard__btn::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .pcard:hover .pcard__btn { background: var(--color-lime-pulse); }
  .pcard__meta { font-size: 10px; color: rgba(252,252,247,.6); }

  /* 3. Feature */
  .feature__grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .feature__grid { grid-template-columns: 0.85fr 1.15fr; gap: 72px; } }
  .feature__text { display: grid; gap: 16px; justify-items: start; max-width: 460px; }
  .feature__p, .science__p { color: var(--color-pewter); max-width: 420px; }
  .feature__media { display: grid; gap: 10px; }
  .callout { position: relative; border-radius: var(--radius-cards); background: var(--color-warm-stone); aspect-ratio: 16 / 9.5; overflow: hidden; }
  .callout img { position: absolute; inset: 6% 12% 0; width: 76%; height: 94%; object-fit: contain; }
  .callout__tag { position: absolute; left: var(--x); top: var(--y); display: grid; justify-items: center; translate: -50% 0; }
  .callout__tag .pill { font-size: 10px; padding: 4px 8px; border-width: 1px; background: var(--color-warm-stone); }
  .callout__tag i { display: block; width: 1px; height: var(--h); background: var(--color-forest-depths); position: relative; }
  .callout__tag i::after { content: ''; position: absolute; bottom: -2px; left: -2px; width: 5px; height: 5px; border-radius: 50%; background: var(--color-forest-depths); }
  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .thumbs img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; }

  /* 4. Band */
  .band { padding-block: 0 var(--section-pad); background: var(--color-snow-white); }
  .band__frame { position: relative; border-radius: var(--radius-cards); overflow: hidden; min-height: 460px; display: flex; align-items: flex-end; }
  .band__frame > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .glass { position: relative; margin: 20px; width: calc(100% - 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; padding: 22px 24px; border-radius: 14px; background: rgba(238, 238, 233, 0.55); backdrop-filter: blur(22px) saturate(1.2); -webkit-backdrop-filter: blur(22px) saturate(1.2); border: 1px solid rgba(252,252,247,.5); align-items: end; }
  .glass__item { display: grid; gap: 6px; align-content: end; }
  .glass__item .pill { justify-self: start; font-size: 10px; padding: 3px 7px; border-width: 1px; }
  .glass__value { font-size: clamp(26px, 2.4vw, 34px); font-weight: 300; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .glass__value small { font-size: .5em; margin-left: 2px; }
  .glass__label { font-size: 11px; line-height: 1.4; color: #3a4a33; max-width: 180px; }
  .glass__link { align-self: end; justify-self: start; display: inline-flex; gap: 6px; align-items: center; font-size: 12px; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  /* 5. Science */
  .science { padding-top: 0; }
  .science__grid { display: grid; gap: 32px; }
  .science__grid > *, .feature__grid > * { min-width: 0; }
  @media (min-width: 960px) { .science__grid { grid-template-columns: 0.85fr 1.15fr; gap: 72px; } }
  .science__text { display: grid; grid-template-rows: auto 1fr auto; gap: 32px; padding-block: 4px; }
  .science__text .stack { align-self: center; }
  .science__brand { font-size: 13px; letter-spacing: -0.02em; }
  .bracket { font-family: var(--font-mono); font-size: .85em; }
  .science__btn .dot { width: 16px; height: 16px; border-radius: 50%; background: var(--color-snow-white); position: relative; }
  .science__btn .dot::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: var(--color-forest-depths); }
  .science__btn { justify-self: start; }
  .science__crumb { font-size: 10px; letter-spacing: .02em; }
  .science__crumb span { font-family: var(--font-mono); letter-spacing: .06em; }
  .science__art { border-radius: var(--radius-cards); background: #efefea; aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 10%; color: var(--color-eucalyptus); }

  /* 6. Carousel */
  .stories { padding-top: 0; overflow: hidden; }
  .center-head { display: grid; gap: 10px; justify-items: center; text-align: center; max-width: 600px; margin: 0 auto 32px; }
  .center-head p { color: var(--color-pewter); }
  .carousel { --w: min(820px, 78vw); }
  .carousel__track { display: flex; gap: 16px; padding-left: calc((100vw - var(--w)) / 2); transition: transform .8s var(--ease); }
  .slide { flex: 0 0 var(--w); transition: opacity .5s; opacity: .55; }
  .slide.is-active { opacity: 1; }
  .slide__card { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #3d4a36; color: var(--color-snow-white); }
  .slide__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(.72) saturate(.9); }
  .slide__img--contain { object-fit: contain; padding: 6% 30% 0; background: var(--color-eucalyptus); filter: none; }
  .slide__card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 16%; background: var(--color-forest-depths); z-index: 1; }
  .slide__brand { position: absolute; left: 4%; top: 50%; translate: 0 -50%; z-index: 2; font-size: 18px; letter-spacing: -0.04em; }
  .slide__brand sup { color: var(--color-lime-pulse); }
  .slide__title { position: absolute; left: 22%; right: 6%; top: 50%; translate: 0 -50%; z-index: 2; font-size: clamp(18px, 2vw, 26px); font-weight: 300; letter-spacing: -0.02em; line-height: 1.25; text-wrap: balance; }
  .slide__meta { position: absolute; left: 22%; bottom: 7%; z-index: 2; font-family: var(--font-mono); font-size: 11px; opacity: .8; }
